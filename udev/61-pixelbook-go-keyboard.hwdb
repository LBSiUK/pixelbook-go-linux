# Google Pixelbook Go (Atlas) — remap ChromeOS top-row keys to their labeled functions
evdev:atkbd:dmi:bvn*:bvr*:bd*:svnGoogle:pnAtlas:pvr*
 KEYBOARD_KEY_3b=back
 KEYBOARD_KEY_3c=refresh
 KEYBOARD_KEY_3d=f11
 KEYBOARD_KEY_3e=scale
 KEYBOARD_KEY_3f=brightnessdown
 KEYBOARD_KEY_40=brightnessup
 KEYBOARD_KEY_41=playpause
 KEYBOARD_KEY_42=mute
 KEYBOARD_KEY_43=volumedown
 KEYBOARD_KEY_44=volumeup
